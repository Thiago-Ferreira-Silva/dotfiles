# Generated by Theme Engine - Do not edit manually

background {
    monitor =
    path = {{ wallpaper if wallpaper else "screenshot" }}
    blur_passes = 2
    blur_size = 7
}

input-field {
    monitor =
    size = 200, 50
    outline_thickness = 3
    dots_size = 0.33
    dots_spacing = 0.15
    outer_color = rgb({{ primary_rgb }})
    inner_color = rgba({{ background_rgb }}, {{ opacity.lockscreen }})
    font_color = rgb({{ foreground_rgb }})
    fade_on_empty = false
}
