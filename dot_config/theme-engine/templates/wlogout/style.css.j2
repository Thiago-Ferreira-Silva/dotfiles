/* Generated by Theme Engine - Do not edit manually */

@define-color bg        {{ background }};
@define-color bg-alt    {{ background_dark }};
@define-color surface   {{ surface }};
@define-color surface2  {{ border }};

@define-color fg        {{ foreground }};
@define-color fg-muted  {{ foreground_dark }};

@define-color accent    {{ primary }};
@define-color accent2   {{ secondary }};

@define-color danger    {{ red }};
@define-color warning   {{ yellow }};
@define-color success   {{ green }};

* {
    font-family: "JetBrainsMono Nerd Font", sans-serif;
    font-size: 14px;
    font-weight: 600;
}

window {
    background-color: rgba({{ background_rgb }}, 0.88);
}

button {
    font-size: 20px;
    font-weight: 600;
    background-color: @surface;
    color: @fg;
    border: 1px solid @surface2;
    border-radius: {{ radius }}px;
    margin: 8px;
    padding: 18px;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, box-shadow 150ms ease;
}

button:hover {
    background-color: @surface2;
    color: @accent;
    border-color: @accent;
    box-shadow: 0 0 8px rgba({{ primary_rgb }}, 0.35), inset 0 0 8px rgba({{ primary_rgb }}, 0.08);
}

button:focus {
    background-color: @surface2;
    color: @accent;
    border-color: @accent;
    outline: none;
}

#lock {
    background-image: none;
}

#logout {
    color: @danger;
}

#logout:hover {
    color: @danger;
    border-color: @danger;
    box-shadow: 0 0 8px rgba({{ red_rgb }}, 0.35), inset 0 0 8px rgba({{ red_rgb }}, 0.08);
}

#suspend:hover {
    color: @accent;
}

#hibernate:hover {
    color: @warning;
}

#reboot:hover {
    color: @warning;
    border-color: @warning;
    box-shadow: 0 0 8px rgba({{ yellow_rgb }}, 0.35), inset 0 0 8px rgba({{ yellow_rgb }}, 0.08);
}

#shutdown {
    color: @danger;
}

#shutdown:hover {
    color: @danger;
    border-color: @danger;
    box-shadow: 0 0 8px rgba({{ red_rgb }}, 0.35), inset 0 0 8px rgba({{ red_rgb }}, 0.08);
}
