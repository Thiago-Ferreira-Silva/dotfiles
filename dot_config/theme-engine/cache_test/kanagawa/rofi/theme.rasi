/* Generated by Theme Engine - Do not edit manually */

* {
    background: #1f1f28;
    background-alt: #2a2a37;
    foreground: #dcd7ba;
    selected: #7e9cd8;
    active: #76946a;
    urgent: #c34043;

    bg: #1f1f28;
    surface: #2a2a37;
    fg: #dcd7ba;
    accent: #7e9cd8;
    border-col: #54546d;
    radius: 14px;
    background-color: transparent;
    text-color: @foreground;
}

window {
    background-color: @background;
    border: 2px;
    border-color: @border-col;
    border-radius: @radius;
    padding: 15px;
    width: 35%;
}

element selected {
    background-color: @selected;
    text-color: @background;
    border-radius: @radius;
}