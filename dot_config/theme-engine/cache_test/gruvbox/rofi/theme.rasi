/* Generated by Theme Engine - Do not edit manually */

* {
    background: #282828;
    background-alt: #3c3836;
    foreground: #ebdbb2;
    selected: #fe8019;
    active: #b8bb26;
    urgent: #fb4934;

    bg: #282828;
    surface: #3c3836;
    fg: #ebdbb2;
    accent: #fe8019;
    border-col: #504945;
    radius: 8px;
    background-color: transparent;
    text-color: @foreground;
}

window {
    background-color: @background;
    border: 2px;
    border-color: @border-col;
    border-radius: @radius;
    padding: 15px;
    width: 35%;
}

element selected {
    background-color: @selected;
    text-color: @background;
    border-radius: @radius;
}