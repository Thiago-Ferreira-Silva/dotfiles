/* Generated by Theme Engine - Do not edit manually */

* {
    background: #2e3440;
    background-alt: #3b4252;
    foreground: #d8dee9;
    selected: #88c0d0;
    active: #a3be8c;
    urgent: #bf616a;

    bg: #2e3440;
    surface: #3b4252;
    fg: #d8dee9;
    accent: #88c0d0;
    border-col: #4c566a;
    radius: 10px;
    background-color: transparent;
    text-color: @foreground;
}

window {
    background-color: @background;
    border: 2px;
    border-color: @border-col;
    border-radius: @radius;
    padding: 15px;
    width: 35%;
}

element selected {
    background-color: @selected;
    text-color: @background;
    border-radius: @radius;
}