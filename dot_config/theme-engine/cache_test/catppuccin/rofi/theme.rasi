/* Generated by Theme Engine - Do not edit manually */

* {
    background: #1e1e2e;
    background-alt: #313244;
    foreground: #cdd6f4;
    selected: #cba6f7;
    active: #a6e3a1;
    urgent: #f38ba8;

    bg: #1e1e2e;
    surface: #313244;
    fg: #cdd6f4;
    accent: #cba6f7;
    border-col: #45475a;
    radius: 12px;
    background-color: transparent;
    text-color: @foreground;
}

window {
    background-color: @background;
    border: 2px;
    border-color: @border-col;
    border-radius: @radius;
    padding: 15px;
    width: 35%;
}

element selected {
    background-color: @selected;
    text-color: @background;
    border-radius: @radius;
}