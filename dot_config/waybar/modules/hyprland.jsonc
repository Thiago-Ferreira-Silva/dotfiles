{
    // ─────────────────────────────────────────────
    // Hyprland Workspaces
    // ─────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{id}",
        "all-outputs": true,
        "show-special": false,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        },
        "sort-by-number": true,
        "on-click": "activate"
    }
}
