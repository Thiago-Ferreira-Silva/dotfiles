#!/bin/bash

set -e

echo "=== Iniciando instalação de pacotes do sistema ==="

if command -v pacman &> /dev/null; then
    echo "Gerenciador pacman detectado. Instalando pacotes nativos..."
    sudo pacman -S --needed --noconfirm \
    {{- range .packages.native }}
        "{{ . }}" \
    {{- end }}

    # Instalação de pacotes AUR se yay ou paru estiver disponível
    AUR_HELPER=""
    if command -v yay &> /dev/null; then
        AUR_HELPER="yay"
    elif command -v paru &> /dev/null; then
        AUR_HELPER="paru"
    else
        echo "AUR helper não detectado. Instalando yay-bin de forma automatizada..."
        # Instala dependências de compilação necessárias para o yay
        sudo pacman -S --needed --noconfirm git base-devel
        
        # Faz o clone e compila o yay-bin no diretório /tmp
        rm -rf /tmp/yay-bin
        git clone https://aur.archlinux.org/yay-bin.git /tmp/yay-bin
        (cd /tmp/yay-bin && makepkg -si --noconfirm)
        rm -rf /tmp/yay-bin
        
        if command -v yay &> /dev/null; then
            AUR_HELPER="yay"
        fi
    fi

    if [ -n "$AUR_HELPER" ]; then
        echo "AUR helper ($AUR_HELPER) detectado. Instalando pacotes AUR..."
        $AUR_HELPER -S --needed --noconfirm \
        {{- range .packages.aur }}
            "{{ . }}" \
        {{- end }}
    else
        echo "Erro: Não foi possível configurar ou detectar um AUR helper. Os seguintes pacotes AUR precisam ser instalados manualmente:"
        {{- range .packages.aur }}
        echo " - {{ . }}"
        {{- end }}
    fi

    echo "=== Configurando serviços e recursos de sistema (fora do HOME) ==="

    # 1. Configurar Zsh como shell padrão
    if [ -x /bin/zsh ]; then
        if [ "$SHELL" != "/bin/zsh" ]; then
            echo "Alterando shell padrão para /bin/zsh..."
            chsh -s /bin/zsh || sudo chsh -s /bin/zsh "$USER"
        fi
    fi

    # 2. Habilitar serviços essenciais no Systemd
    echo "Habilitando serviços essenciais no systemd..."
    sudo systemctl enable NetworkManager.service || true
    sudo systemctl enable bluetooth.service || true
    sudo systemctl enable greetd.service || true

    # 3. Configurar Greetd (se instalado)
    if [ -d /etc/greetd ]; then
        echo "Configurando /etc/greetd/config.toml..."
        sudo tee /etc/greetd/config.toml > /dev/null << 'EOF'
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --remember-session --cmd Hyprland"
user = "greeter"
EOF
    fi

else
    echo "Aviso: pacman não encontrado. Este script é otimizado para Arch Linux."
fi

echo "=== Instalação e configuração do sistema concluídas ==="
